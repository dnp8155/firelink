{
  "name": "RevenueStream",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "commission",
        "fee",
        "subscription",
        "advertising",
        "lead",
        "service"
      ],
      "default": "fee"
    },
    "model_type": {
      "type": "string",
      "enum": [
        "percentage",
        "flat",
        "subscription",
        "referral"
      ],
      "default": "flat"
    },
    "rate": {
      "type": "number",
      "default": 0
    },
    "fee": {
      "type": "number",
      "default": 0
    },
    "applies_to": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "name",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}