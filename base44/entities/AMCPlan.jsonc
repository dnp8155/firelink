{
  "name": "AMCPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "basic",
        "standard",
        "premium",
        "custom"
      ],
      "default": "standard"
    },
    "duration_months": {
      "type": "number",
      "default": 12
    },
    "price": {
      "type": "number"
    },
    "mrp": {
      "type": "number"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "terms": {
      "type": "string"
    },
    "visit_count": {
      "type": "number",
      "default": 4
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "vendor_id",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.vendor_id": "{{user.data.vendor_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.vendor_id": "{{user.data.vendor_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}