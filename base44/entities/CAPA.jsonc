{
  "name": "CAPA",
  "type": "object",
  "properties": {
    "capa_number": {
      "type": "string"
    },
    "finding": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "asset_name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "responsible_person": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "corrective_action": {
      "type": "string"
    },
    "preventive_action": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "in_progress",
        "awaiting_verification",
        "closed"
      ],
      "default": "open"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "capa_number",
    "finding",
    "organization_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}