{
  "name": "VendorStaff",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "staff_role": {
      "type": "string",
      "enum": [
        "VENDOR_ADMIN",
        "SALES_MANAGER",
        "PRODUCT_MANAGER",
        "INVENTORY_MANAGER",
        "ORDER_MANAGER",
        "SERVICE_MANAGER",
        "FINANCE_USER",
        "VIEW_ONLY"
      ],
      "default": "VIEW_ONLY"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "vendor_id",
    "email",
    "staff_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}