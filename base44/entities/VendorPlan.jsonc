{
  "name": "VendorPlan",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "free",
        "silver",
        "gold"
      ],
      "default": "free"
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "duration_months": {
      "type": "number",
      "default": 12
    },
    "product_limit": {
      "type": "number",
      "default": 20
    },
    "service_limit": {
      "type": "number",
      "default": 5
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "search_priority": {
      "type": "number",
      "default": 0
    },
    "highlight_color": {
      "type": "string",
      "default": "slate"
    },
    "popular": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "tier",
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}