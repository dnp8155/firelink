{
  "name": "Quotation",
  "type": "object",
  "properties": {
    "rfq_id": {
      "type": "string"
    },
    "rfq_number": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "specification": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "delivery_days": {
      "type": "number"
    },
    "validity_days": {
      "type": "number",
      "default": 30
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "revised",
        "accepted",
        "rejected",
        "expired"
      ],
      "default": "submitted"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "revision_of": {
      "type": "string"
    },
    "revision_notes": {
      "type": "string"
    }
  },
  "required": [
    "rfq_id",
    "vendor_id",
    "total"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}