{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "before_value": {
      "type": "string"
    },
    "after_value": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_name",
    "action",
    "module"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}