{
  "name": "FireAuditRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "preferred_date": {
      "type": "string",
      "format": "date"
    },
    "audit_type": {
      "type": "string",
      "enum": [
        "fire_safety",
        "electrical_safety",
        "building_safety",
        "compliance",
        "comprehensive"
      ],
      "default": "fire_safety"
    },
    "description": {
      "type": "string"
    },
    "assigned_vendor_id": {
      "type": "string"
    },
    "assigned_vendor_name": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "report_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "request_number",
    "customer_id",
    "audit_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.assigned_vendor_id": "{{user.data.vendor_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.assigned_vendor_id": "{{user.data.vendor_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}